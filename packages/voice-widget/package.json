{
  "name": "@ardyn/voice-widget",
  "version": "0.1.0",
  "description": "Embeddable voice widget for the Ardyn AI SDR agent — Preact + pipecat + LiveKit + Deepgram",
  "type": "module",
  "license": "Apache-2.0",
  "repository": "github.com/Kylewilson04/ardyn-sdr-agent",
  "files": [
    "dist"
  ],
  "main": "./dist/ardyn-voice-widget.umd.js",
  "module": "./dist/ardyn-voice-widget.es.js",
  "unpkg": "./dist/ardyn-voice-widget.iife.js",
  "exports": {
    ".": {
      "import": "./dist/ardyn-voice-widget.es.js",
      "require": "./dist/ardyn-voice-widget.umd.js",
      "default": "./dist/ardyn-voice-widget.iife.js"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@deepgram/sdk": "^3.9.0",
    "@pipecat-ai/client-js": "^1.13.0",
    "livekit-client": "^2.8.0",
    "zod": "^3.25.76"
  },
  "peerDependencies": {
    "preact": "^10.24.0"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.9.0",
    "preact": "^10.24.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vite-plugin-css-injected-by-js": "^3.5.0"
  }
}
