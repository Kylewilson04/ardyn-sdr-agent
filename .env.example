# Ardyn SDR Agent — Environment
# Copy to .env and fill in values.

# ── Database ──────────────────────────────────────────────────────────────
POSTGRES_USER=ardyn
POSTGRES_PASSWORD=ardyn_dev
POSTGRES_DB=ardyn_sdr
DATABASE_URL=postgresql+asyncpg://ardyn:ardyn_dev@localhost:5432/ardyn_sdr

# ── Redis ─────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── LLM Providers ─────────────────────────────────────────────────────────
# Ardyn SDR Agent supports any LangChain-compatible LLM backend.
# Default: open-weight models via Ollama (free, local).
#
# For Ollama (default):
#   LLM_BACKEND=ollama
#   OLLAMA_BASE_URL=http://localhost:11434
#   OLLAMA_MODEL=llama3.1:70b
#
# For Groq (fast, open-weight cloud):
#   LLM_BACKEND=groq
#   GROQ_API_KEY=
#   GROQ_MODEL=llama-3.1-70b-versatile
#
# For OpenAI (not default — use only if intentionally choosing commercial):
#   LLM_BACKEND=openai
#   OPENAI_API_KEY=
#   OPENAI_MODEL=gpt-4o
#
# For Anthropic (not default):
#   LLM_BACKEND=anthropic
#   ANTHROPIC_API_KEY=
#   ANTHROPIC_MODEL=claude-sonnet-4-20250514

LLM_BACKEND=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:70b
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ── Email (Postal SMTP) ──────────────────────────────────────────────────
SMTP_HOST=localhost
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=

# ── Observability (LangFuse) ──────────────────────────────────────────────
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000

# ── CRM (Nango.dev) ───────────────────────────────────────────────────────
NANGO_SECRET_KEY=
NANGO_HOST=https://api.nango.dev

# ── Voice (Deepgram) ─────────────────────────────────────────────────────
DEEPGRAM_API_KEY=

# ── Auth ─────────────────────────────────────────────────────────────────
API_KEY=
JWT_SECRET=

# ── Postal Infrastructure ────────────────────────────────────────────────
RABBITMQ_USER=ardyn
RABBITMQ_PASSWORD=ardyn_dev
LANGFUSE_SECRET=
LANGFUSE_SALT=