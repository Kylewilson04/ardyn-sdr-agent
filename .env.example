# Ardyn SDR Agent — Environment
# Copy to .env and fill in values.

# ── Database ──────────────────────────────────────────────────────────────
POSTGRES_USER=ardyn
POSTGRES_PASSWORD=ardyn_dev
POSTGRES_DB=ardyn_sdr
DATABASE_URL=postgresql+asyncpg://ardyn:ardyn_dev@localhost:5432/ardyn_sdr

# ── Redis ─────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── LLM Providers ─────────────────────────────────────────────────────────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Model: gpt-4o-mini (researcher), claude-sonnet-4-20250514 (writing), gpt-4o (supervisor)

# ── Email (Postal SMTP) ──────────────────────────────────────────────────
SMTP_HOST=localhost
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=

# ── Observability (LangFuse) ──────────────────────────────────────────────
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000

# ── CRM (Nango.dev) ───────────────────────────────────────────────────────
NANGO_SECRET_KEY=
NANGO_HOST=https://api.nango.dev

# ── Voice (Deepgram) ─────────────────────────────────────────────────────
DEEPGRAM_API_KEY=

# ── Auth ─────────────────────────────────────────────────────────────────
API_KEY=
JWT_SECRET=

# ── Postal Infrastructure ────────────────────────────────────────────────
RABBITMQ_USER=ardyn
RABBITMQ_PASSWORD=ardyn_dev
LANGFUSE_SECRET=
LANGFUSE_SALT=