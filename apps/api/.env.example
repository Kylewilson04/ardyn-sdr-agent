# Ardyn SDR Agent — API Environment Variables
# Copy to .env and fill in values

# ── Application ──────────────────────────────────────
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# ── Server ───────────────────────────────────────────
HOST=0.0.0.0
PORT=8000

# ── Database ─────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://sdr:sdr@localhost:5432/ardyn_sdr
DATABASE_POOL_SIZE=20
DATABASE_ECHO=false

# ── CORS ─────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ── LLM ──────────────────────────────────────────────
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# ── Postal SMTP ──────────────────────────────────────
POSTAL_API_URL=https://postal.yourdomain.com
POSTAL_API_KEY=your-postal-api-key
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
FROM_EMAIL=ardyn@sdr.ardyn.ai
FROM_NAME=Ardyn SDR
REPLY_WEBHOOK_SECRET=change-me

# ── CRM / Nango ──────────────────────────────────────
NANGO_SECRET_KEY=
NANGO_BASE_URL=https://api.nango.dev
NANGO_INTEGRATION_ID=
CRM_SYNC_ENABLED=false

# ── Auth ─────────────────────────────────────────────
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
API_KEYS=dev-key-change-me

# ── Agent ────────────────────────────────────────────
AGENT_MAX_CONCURRENT_TASKS=10
AGENT_RESEARCH_TIMEOUT_SECONDS=120
AGENT_EMAIL_GENERATION_TIMEOUT_SECONDS=60